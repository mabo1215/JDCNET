{
  "experiment_name": "student_xray_dist",
  "manifest_path": "data/covid_real/covid_paired_xray_target_manifest.csv",
  "output_dir": "runs/student_xray_dist",
  "seed": 42,
  "model": {
    "name": "student",
    "num_classes": 2,
    "input_size": 128,
    "use_dpe": false,
    "use_mhra": false,
    "use_dfpn": false,
    "paired_input": false
  },
  "data": {
    "train_split": "train",
    "val_split": "val",
    "train_modalities": ["xray"],
    "val_modalities": ["xray"],
    "batch_size": 16,
    "num_workers": 0,
    "paired_image_column": "teacher_image_path",
    "use_weighted_sampler": true
  },
  "optimization": {
    "epochs": 50,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001
  },
  "distillation": {
    "enabled": true,
    "temperature": 4.0,
    "alpha": 0.0,
    "teacher_checkpoint": "runs/teacher_ct/best.pt",
    "dist_weight": 1.0,
    "dist_beta": 1.0,
    "dist_gamma": 1.0
  }
}
